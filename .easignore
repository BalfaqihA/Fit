# What NOT to upload to EAS Build. When this file exists, EAS uses it instead of
# .gitignore, so it must also re-list the usual ignores (node_modules, etc.).

# Dependencies — reinstalled in the cloud
node_modules/

# Expo / build outputs (android is regenerated by prebuild from app.json)
.expo/
dist/
web-build/
expo-env.d.ts
android/
ios/

# Backend & data sets — not part of the mobile app build
functions/
functions-chatbot/
fitness_data_project/
*.csv
*.zip

# Tests / e2e / coverage
.maestro/
__mocks__/
coverage/

# Env files & secrets (build env comes from eas.json / EAS)
.env
.env.*
*.jks
*.p8
*.p12
*.key
*.keystore
*.mobileprovision
*.pem

# VCS / editor / OS / logs
.git/
.github/
.vscode/
.DS_Store
*.log
