rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Admin identity comes ONLY from the `admin` custom claim on the ID
    // token. It is never stored on `users/{uid}` because a user can write
    // their own user doc (`allow update: if isOwner(uid)` below) and could
    // self-grant. All admin mutations go through Cloud Functions (Admin SDK
    // bypasses these rules); these reads just let the admin app load data.
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // True iff `claimedOwner` matches the actual `authorId` of the
    // referenced post. Used to prevent clients from spoofing `postOwnerId`
    // on like/comment writes (which would misroute activity notifications).
    function postOwnerMatches(postId, claimedOwner) {
      return get(/databases/$(database)/documents/communityPosts/$(postId)).data.authorId == claimedOwner;
    }

    match /users/{uid} {
      // Public-profile read access: any signed-in user can read a user
      // document so the community search and "other user profile" screens
      // work. Subcollections (workouts, measurements, etc.) remain owner-only.
      allow read: if isSignedIn();
      allow create: if isOwner(uid);
      // `followerCount` / `followingCount` are derived counters maintained by
      // the `on_follow_created` / `on_follow_deleted` triggers (Admin SDK
      // bypasses these rules). A user can edit the rest of their own doc but
      // must NOT be able to forge their own follower numbers.
      allow update: if isOwner(uid)
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['followerCount', 'followingCount']);
      allow delete: if false;

      match /workouts/{workoutId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid);
        allow update, delete: if false;
      }

      match /measurements/{measurementId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid);
        allow update, delete: if false;
      }

      match /xp_events/{eventId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid);
        allow update, delete: if false;
      }

      match /achievements/{achievementId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid);
        allow update, delete: if false;
      }

      match /plans/{planId} {
        allow read, update: if isOwner(uid);
        allow create, delete: if false;
      }

      // Per-user analytics snapshot maintained by Cloud Functions (admin SDK
      // bypasses these rules on write). Owner can read their own snapshot.
      match /insights/{doc} {
        allow read: if isOwner(uid);
        allow create, update, delete: if false;
      }
    }

    // Community: posts visible to all signed-in users.
    match /communityPosts/{postId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.caption is string
        && request.resource.data.caption.size() <= 500
        && request.resource.data.likeCount == 0
        && request.resource.data.commentCount == 0
        // Every new post starts visible so the moderated feed query
        // (where moderationStatus == 'visible') includes it.
        && request.resource.data.moderationStatus == 'visible';

      // Counters (`likeCount`, `commentCount`) are maintained by Firestore
      // triggers in `functions/main.py` and must NOT be writable by clients.
      // Author-only edits cover caption and image; nothing else.
      allow update: if isSignedIn()
        && resource.data.authorId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['caption', 'imageUrl', 'imagePath', 'updatedAt']);

      allow delete: if isOwner(resource.data.authorId);
    }

    match /comments/{commentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.postId is string
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 500
        && request.resource.data.postOwnerId is string
        && request.resource.data.moderationStatus == 'visible'
        && postOwnerMatches(
            request.resource.data.postId,
            request.resource.data.postOwnerId
          );
      allow update: if false;
      allow delete: if isOwner(resource.data.authorId);
    }

    // Composite id `{postId}_{uid}` makes one-like-per-user a structural property.
    match /likes/{likeId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && likeId == request.resource.data.postId + '_' + request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.postOwnerId is string
        && postOwnerMatches(
            request.resource.data.postId,
            request.resource.data.postOwnerId
          );
      allow update: if false;
      allow delete: if isOwner(resource.data.userId);
    }

    // Reports are write-only for users; admins read them in-app.
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.reportedBy == request.auth.uid
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 1
        && request.resource.data.reason.size() <= 300;
      allow update, delete: if false;
    }

    // Support chat: a per-user thread (doc id == uid) that the member and any
    // admin can both read and append messages to. The thread doc holds the
    // last-message preview + unread counters for the inbox list.
    match /supportThreads/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if (
            (isOwner(uid)
              && request.resource.data.senderRole == 'user'
              && request.resource.data.senderId == request.auth.uid)
            || (isAdmin()
              && request.resource.data.senderRole == 'admin'
              && request.resource.data.senderId == request.auth.uid)
          )
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 1000;
        allow update, delete: if false;
      }
    }

    // Follow graph. Composite id `{followerId}_{followingId}` makes
    // one-follow-per-pair a structural property (mirrors /likes). The
    // follower/following counters on /users are moved only by the
    // on_follow_created / on_follow_deleted triggers.
    match /follows/{followId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && followId == request.resource.data.followerId + '_' + request.resource.data.followingId
        && request.resource.data.followerId == request.auth.uid
        && request.resource.data.followingId is string
        && request.resource.data.followingId != request.auth.uid;
      allow update: if false;
      allow delete: if isOwner(resource.data.followerId);
    }

    // Stories: 24h ephemeral posts visible to all signed-in users. The app
    // filters expired stories client-side (expiresAt > now); a scheduled
    // function hard-deletes them. Author-only create/delete; never updated.
    match /stories/{storyId} {
      allow read: if isSignedIn();
      // `expiresAt` is milliseconds since epoch and must land inside the
      // published TTL window (24h + 1h slack for client clock skew). Without a
      // cap, a client could write effectively-permanent stories.
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.expiresAt is number
        && request.resource.data.expiresAt > request.time.toMillis()
        && request.resource.data.expiresAt <=
            request.time.toMillis() + 25 * 60 * 60 * 1000;
      allow update: if false;
      allow delete: if isOwner(resource.data.authorId);

      // "Seen by" — one doc per viewer, id == viewerId, idempotent.
      match /views/{viewerId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && viewerId == request.auth.uid
          && request.resource.data.viewerId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // Notifications are SERVER-ONLY writes (created by the like/comment/
    // follow/post triggers via the Admin SDK, which bypasses these rules).
    // The recipient can read their own and flip `read` to mark them seen.
    match /notifications/{notificationId} {
      allow read: if isSignedIn()
        && resource.data.recipientId == request.auth.uid;
      allow create: if false;
      allow update: if isSignedIn()
        && resource.data.recipientId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['read']);
      allow delete: if isSignedIn()
        && resource.data.recipientId == request.auth.uid;
    }

    // ---- Chatbot collections (Gemini-backed) ----
    // All chatbot writes go through Cloud Functions using the admin SDK,
    // which bypasses these rules. Owner-read is what the rules control.

    // Knowledge base — readable by any signed-in user, never client-writable.
    match /fitness_knowledge/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Exercise dataset — read-only reference data seeded by the admin SDK
    // (scripts/seed-exercise-library.ts). The chatbot reads it server-side.
    match /exercise_library/{exerciseId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Per-user chat memory — owner-readable. Functions writes via admin SDK.
    match /chat_memory/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Per-user daily Gemini usage — owner-readable for quota UIs.
    match /chatbot_usage/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Chat sessions and their messages. Each session has a `userId` field
    // that we check on read; clients can NOT write (server is the only
    // writer to keep audit fields tamper-proof).
    match /chat_sessions/{sessionId} {
      allow read: if isSignedIn()
        && resource.data.userId == request.auth.uid;
      allow write: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && get(/databases/$(database)/documents/chat_sessions/$(sessionId))
              .data.userId == request.auth.uid;
        allow write: if false;
      }
    }

    // User feedback on a specific assistant message. Create-only by the
    // author; reads happen server-side via the admin SDK.
    match /chatbot_feedback/{feedbackId} {
      allow read: if false;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.messageId is string
        && request.resource.data.rating in ['up', 'down']
        && (
          !('reason' in request.resource.data)
          || (request.resource.data.reason is string
              && request.resource.data.reason.size() <= 300)
        );
      allow update, delete: if false;
    }

    // ---- Admin section ----
    // Admins READ these in-app; every WRITE is performed server-side by an
    // admin Cloud Function via the Admin SDK (which bypasses these rules), so
    // the client write path is closed everywhere.

    match /adminAuditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /adminStats/{doc=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /adminSettings/{doc=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /userModeration/{uid} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /contentModeration/{contentId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
